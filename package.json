{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "raycast-commitlint",
  "title": "Commitlint",
  "description": "Compose conventional commit messages with live rule checking",
  "icon": "extension-icon.png",
  "author": "pomodorozhong",
  "license": "MIT",
  "platforms": ["macOS", "Windows"],
  "commands": [
    {
      "name": "compose-commit",
      "title": "Compose Commit",
      "description": "Compose a conventional commit message with type, scope, title, body, and footer",
      "mode": "view"
    },
    {
      "name": "quick-commit",
      "title": "Quick Commit",
      "description": "Quickly compose a commit header with type, scope, and title",
      "mode": "no-view",
      "arguments": [
        {
          "name": "type",
          "placeholder": "type",
          "type": "dropdown",
          "data": [
            { "title": "feat", "value": "feat" },
            { "title": "fix", "value": "fix" },
            { "title": "docs", "value": "docs" },
            { "title": "refactor", "value": "refactor" },
            { "title": "test", "value": "test" },
            { "title": "style", "value": "style" },
            { "title": "perf", "value": "perf" },
            { "title": "build", "value": "build" },
            { "title": "ci", "value": "ci" },
            { "title": "chore", "value": "chore" },
            { "title": "revert", "value": "revert" }
          ],
          "required": true
        },
        {
          "name": "scope",
          "placeholder": "scope",
          "type": "text",
          "required": false
        },
        {
          "name": "title",
          "placeholder": "title",
          "type": "text",
          "required": true
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.15",
    "@raycast/utils": "^1.19.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "~22.13.10",
    "@types/react": "^19.0.12",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  }
}
